# シェアファイル設定。相対パスはShareFileディレクトリ基準。
# 同名の環境変数 (SHAREFILE_*) があればそちらを優先します。

# 共有フォルダ
SHAREFILE_SHARED_DIR=shared
# 削除したファイルの移動先（ゴミ箱。共有フォルダの外）
SHAREFILE_TRASH_DIR=trash
# ログ出力先
SHAREFILE_LOG_DIR=logs
# 待ち受けホスト（Tailscale Serveを使うため通常は127.0.0.1のまま）
SHAREFILE_HOST=127.0.0.1
SHAREFILE_PORT=8765
# 最大アップロードサイズ(MB)。1ファイルあたり
SHAREFILE_MAX_UPLOAD_MB=10240
# Tailscale ServeのHTTPSポート（既存のServe設定を壊さないよう443以外）
SHAREFILE_TAILSCALE_HTTPS_PORT=8443
# 許可する追加Hostヘッダ（カンマ区切り）。*.ts.net, localhost, 127.0.0.1, 100.x.x.xは常に許可
SHAREFILE_ALLOWED_HOSTS=
